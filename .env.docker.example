[TEMPLATE]
# ClearLedger — Docker Compose Environment Variables
#
# This file is the Compose-network counterpart to the root .env.example. Create
# the git-ignored copy before starting the stack:
#
#   cp .env.docker.example .env.docker
#
# docker-compose.yml loads it (via `env_file`) for the `indexer` and `web`
# services, so it stays separate from the host-oriented `.env.local` used for
# non-Docker development. Only the values that the Compose network changes
# differ from .env.example:
#
#   DATABASE_URL             points at the `db` service hostname instead of
#                            localhost, because the indexer runs in a container
#   INDEXER_MIGRATIONS_DIR   points at the path migrations are copied to inside
#                            the indexer image (/app/db/migrations)
#   NEXT_PUBLIC_API_BASE_URL stays http://localhost:8080 — it is resolved by
#                            the browser on the host, not by the container
#
# Placeholder values only: never commit real secrets or funded testnet keys,
# consistent with .env.example. Set JWT_SECRET and SERVER_SEED to real secrets
# (and APP_ENV=production) before running anywhere but a local machine.
#
# For the full variable reference — layers, types, defaults, and sources — see
# the root .env.example.

# ── Frontend / SDK (Next.js NEXT_PUBLIC_*) ───────────────────────────────────
# Baked into the web image at build time (docker-compose.yml passes these as
# build args) and read by the web container at runtime.

# NEXT_PUBLIC_STELLAR_NETWORK
#   Layer: frontend, SDK
#   Type: string enum: testnet | mainnet | futurenet
#   Required: yes
#   Default: testnet
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# NEXT_PUBLIC_HORIZON_URL
#   Layer: frontend, SDK
#   Type: URL string
#   Required: yes
#   Default: https://horizon-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# NEXT_PUBLIC_SOROBAN_RPC_URL
#   Layer: frontend, SDK
#   Type: URL string
#   Required: yes
#   Default: https://soroban-testnet.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# NEXT_PUBLIC_NETWORK_PASSPHRASE
#   Layer: frontend, SDK
#   Type: string
#   Required: yes
#   Default: Test SDF Network ; September 2015
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ── Soroban contract IDs (frontend / SDK) ────────────────────────────────────
# NEXT_PUBLIC_REGISTRY_CONTRACT_ID
#   Layer: frontend, SDK
#   Type: Stellar contract ID string
#   Required: yes
NEXT_PUBLIC_REGISTRY_CONTRACT_ID=CABGWVIZFF62FG67ZGFEP67NEEY4WYTMFURDMFTKKNRDAFPKPOJDTN4C

# NEXT_PUBLIC_INVOICE_CONTRACT_ID
#   Layer: frontend, SDK
#   Type: Stellar contract ID string
#   Required: yes
NEXT_PUBLIC_INVOICE_CONTRACT_ID=CA4O3MR7LWHRSUDBNU6FY6UDFFYBN7TGBZXBDZB4OYYXFYXIFJ6RJF6B

# NEXT_PUBLIC_POOL_CONTRACT_ID
#   Layer: frontend, SDK
#   Type: Stellar contract ID string
#   Required: yes
NEXT_PUBLIC_POOL_CONTRACT_ID=CAKEWH7SJCXGV2MH2WZYIX3QDPTSSBQFXYVYBOWAGLNBBZMPLE2US6CS

# NEXT_PUBLIC_ESCROW_CONTRACT_ID
#   Layer: frontend, SDK
#   Type: Stellar contract ID string
#   Required: yes
NEXT_PUBLIC_ESCROW_CONTRACT_ID=CAJWGUKDTTC3SKN4RAAY72J4DVIIYSCFHX6GIMNTT22ABMISJK4GBCEH

# NEXT_PUBLIC_AGENT_REGISTRY_CONTRACT_ID
#   Layer: frontend, SDK
#   Type: Stellar contract ID string
#   Required: no (until Underwrite's agent-registry contract is deployed)
#   Default: none
NEXT_PUBLIC_AGENT_REGISTRY_CONTRACT_ID=

# ── Asset configuration (frontend / SDK) ─────────────────────────────────────
# NEXT_PUBLIC_USDC_ISSUER
#   Layer: frontend, SDK
#   Type: Stellar public key string
#   Required: yes
NEXT_PUBLIC_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# NEXT_PUBLIC_USDC_ASSET_CODE
#   Layer: frontend, SDK
#   Type: string
#   Required: yes
NEXT_PUBLIC_USDC_ASSET_CODE=USDC

# ── Go indexer / backend (plain names, no NEXT_PUBLIC_ prefix) ───────────────
# Read only by the `indexer` container. Never exposed to the browser.

# STELLAR_NETWORK
#   Layer: backend/indexer
#   Type: string enum: testnet | mainnet | futurenet
#   Required: yes
STELLAR_NETWORK=testnet

# HORIZON_URL
#   Layer: backend/indexer
#   Type: URL string
#   Required: yes
#   Note: reachable over the Compose network, not via localhost.
HORIZON_URL=https://horizon-testnet.stellar.org

# SOROBAN_RPC_URL
#   Layer: backend/indexer
#   Type: URL string
#   Required: yes
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# NETWORK_PASSPHRASE
#   Layer: backend/indexer
#   Type: string
#   Required: yes
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# REGISTRY_CONTRACT_ID
#   Layer: backend/indexer
#   Type: Stellar contract ID string
#   Required: yes
REGISTRY_CONTRACT_ID=CABGWVIZFF62FG67ZGFEP67NEEY4WYTMFURDMFTKKNRDAFPKPOJDTN4C

# INVOICE_CONTRACT_ID
#   Layer: backend/indexer
#   Type: Stellar contract ID string
#   Required: yes
INVOICE_CONTRACT_ID=CA4O3MR7LWHRSUDBNU6FY6UDFFYBN7TGBZXBDZB4OYYXFYXIFJ6RJF6B

# POOL_CONTRACT_ID
#   Layer: backend/indexer
#   Type: Stellar contract ID string
#   Required: yes
POOL_CONTRACT_ID=CAKEWH7SJCXGV2MH2WZYIX3QDPTSSBQFXYVYBOWAGLNBBZMPLE2US6CS

# ESCROW_CONTRACT_ID
#   Layer: backend/indexer
#   Type: Stellar contract ID string
#   Required: yes
ESCROW_CONTRACT_ID=CAJWGUKDTTC3SKN4RAAY72J4DVIIYSCFHX6GIMNTT22ABMISJK4GBCEH

# AGENT_REGISTRY_CONTRACT
#   Layer: backend/indexer
#   Type: Stellar contract ID string
#   Required: no (until Underwrite's agent-registry contract is deployed)
#   Default: none
AGENT_REGISTRY_CONTRACT=

# USDC_ISSUER
#   Layer: backend/indexer
#   Type: Stellar public key string
#   Required: yes
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# USDC_ASSET_CODE
#   Layer: backend/indexer
#   Type: string
#   Required: yes
USDC_ASSET_CODE=USDC

# ── Indexer / Go API ─────────────────────────────────────────────────────────
# DATABASE_URL
#   Layer: indexer/backend
#   Type: PostgreSQL connection URL
#   Required: yes
#   Default: none
#   Note: `db` is the Compose service name from docker-compose.yml. Using
#         localhost here would make the container dial itself instead of the
#         Postgres service.
DATABASE_URL=postgresql://postgres:postgres@db:5432/clearledger?sslmode=disable

# DATABASE_URL_UNPOOLED
#   Layer: indexer/backend
#   Type: PostgreSQL connection URL
#   Required: no
#   Default: none
DATABASE_URL_UNPOOLED=

# INDEXER_MIGRATIONS_DIR
#   Layer: indexer/backend
#   Type: directory path inside the container
#   Required: yes (for the indexer image)
#   Default: /app/db/migrations (also set as the image's built-in default)
#   Note: indexer/Dockerfile copies indexer/db/migrations to this path so the
#         built-in migration runner finds it at startup.
INDEXER_MIGRATIONS_DIR=/app/db/migrations

# API_PORT
#   Layer: indexer/backend
#   Type: integer port
#   Required: no
#   Default: 8080
#   Note: must match the container port published in docker-compose.yml.
API_PORT=8080

# PORT
#   Layer: indexer/backend deployment
#   Type: integer port
#   Required: no
#   Default: unused unless API_PORT is empty
PORT=

# INDEXER_POLL_INTERVAL_MS
#   Layer: indexer/backend
#   Type: integer milliseconds
#   Required: no
#   Default: 5000
INDEXER_POLL_INTERVAL_MS=5000

# APP_ENV
#   Layer: indexer/backend
#   Type: string enum: development | production
#   Required: no
#   Default: development
APP_ENV=development

# JWT_SECRET
#   Layer: indexer/backend
#   Type: string secret
#   Required: yes
#   Default: none
#   Note: placeholder only — generate a real secret before any shared deploy.
JWT_SECRET=change_me_before_production

# JWT_EXPIRY_HOURS
#   Layer: indexer/backend
#   Type: integer hours
#   Required: no
#   Default: 24
JWT_EXPIRY_HOURS=24

# SERVER_SEED
#   Layer: indexer/backend
#   Type: string secret (Stellar keypair seed, starts with 'S')
#   Required: yes in production; leave empty for local/development — the
#            indexer generates a valid random keypair at startup when unset.
#   Default: none
SERVER_SEED=

# ALLOWED_ORIGINS
#   Layer: indexer/backend
#   Type: comma-separated URLs
#   Required: no
#   Default: http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# CORS_ALLOWED_ORIGINS
#   Layer: indexer/backend
#   Type: comma-separated URLs
#   Required: no
#   Default: only read when ALLOWED_ORIGINS above is unset
CORS_ALLOWED_ORIGINS=

# RATE_LIMIT_RPS
#   Layer: indexer/backend
#   Type: integer requests per second (per client)
#   Required: no
#   Default: 10
RATE_LIMIT_RPS=10

# WEBHOOK_SECRET_OVERLAP
#   Layer: indexer/backend
#   Type: Go duration (for example 24h, 1h)
#   Required: no
#   Default: 24h (maximum 720h)
#   Source: local .env or deployment env
#   Notes: how long the previous webhook signing secret remains valid after a
#          rotation. Set it to at least the time subscribers need to install
#          the new secret. A second rotation is refused until the previous
#          overlap expires.
WEBHOOK_SECRET_OVERLAP=24h

# SENTRY_DSN
#   Layer: indexer/backend
#   Type: URL string (Sentry project DSN)
#   Required: no
#   Default: none — leave empty to disable error tracking entirely
SENTRY_DSN=

# ── Frontend-only settings ───────────────────────────────────────────────────
# NEXT_PUBLIC_API_BASE_URL
#   Layer: frontend
#   Type: URL string
#   Required: no
#   Default: http://localhost:8080
#   Note: resolved by the browser on the host, so localhost (not the `indexer`
#         service name) is correct.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# NEXT_PUBLIC_APP_URL
#   Layer: frontend
#   Type: URL string
#   Required: no
#   Default: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
